class Solution {
public:
    int minimumLevels(vector<int>& possible) {
        int n=possible.size();
        int sum=0;

        // int allZero=accumulate(possible.begin(),possible.end(),0);
        // if(allZero==0)  return -1; // all 0

        for(int i=0;i<n;i++)
        {
            if(possible[i]) // for 1
                sum+=1;
            else            // for 0
                sum-=1;
        }

        int alice=0;
        int bob=sum;
        for(int i=0;i<n-1;i++)  // run for n-1 because bob must participate
        {
           int parity= possible[i] ? 1 : -1;
           alice+=parity;
           bob-=parity;

           if(alice>bob)
            return i+1;

        }
        return -1;
    }
};
