class Solution {
public:
    int maximalSquare(vector<vector<char>>& matrix) {
       int row=matrix.size();
       int col=matrix[0].size();

        vector<vector<int>>dp(row,vector<int>(col,0));

        int side=0;
        // make 1st row & 1st col as 0
          for(int i=0;i<row;i++) { 
            dp[i][0]=(matrix[i][0]-'0'); 
            if(dp[i][0] == 1) side = 1; // Update side if a '1' is found
        } 
        for(int i=0;i<col;i++) { 
            dp[0][i]=(matrix[0][i]-'0'); 
            if(dp[0][i] == 1) side = 1; 
        } 
        
        for(int i=1;i<row;i++)
        {
            for(int j=1;j<col;j++)
            {
                if(matrix[i][j]=='1')
                {
                    int top=dp[i-1][j];
                    int bottom=dp[i][j-1];
                    int diag=dp[i-1][j-1];

                    dp[i][j]=1+min({top,bottom,diag});
                    side=max(side,dp[i][j]);
                }
            }
        }
        return side*side;
    }
};
