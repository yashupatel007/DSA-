class Solution {
public:
    int climbStairs(int n, vector<int>& costs) {
        long long dp3=0,dp2=0,dp1=0;

        for(int i=n-1;i>=0;i--)
        {
            long long jump_one=1+costs[i]+dp1;

            long long jump_two=INT_MAX;
            if(i+2<=n)
                jump_two=4+ costs[i+1]+dp2;
            
            long long jump_three=INT_MAX;
            if(i+3<=n)
                jump_three=9+costs[i+2]+dp3;

            long long mini=min({jump_one,jump_two,jump_three});
            
            dp3=dp2;
            dp2=dp1;
            dp1= mini;
        }
        return dp1;
    }
};
