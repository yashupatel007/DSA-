class Solution {
public:
    int frogJump(vector<int>& heights) {
        int n=heights.size();
        if(n==1)    return 0;
        int prev1=0;
        int prev2=abs(heights[1]-heights[0]);

        for(int i=2;i<n;i++)
        {

            int one_jump=prev2+abs(heights[i]-heights[i-1]);
            int two_jump=prev1+abs(heights[i]-heights[i-2]);

            int energy=min(one_jump,two_jump);
            

            prev1=prev2;
            prev2=energy;
        }
        return prev2;

    }
};
