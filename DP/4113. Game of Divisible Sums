class Solution {
public:
    long long maxDifference(vector<int>& nums) {
        int n=nums.size();
        vector<long long>dp(n+1,0);

        for(int i=n-1;i>=0;i--)
        {
            // Take 1
            long long sum1=nums[i];
            long long res1= (sum1 % 3==0) ? (sum1-dp[i+1]) : (sum1 + dp[i+1]);
            dp[i]=res1;

            // Take 2
            if(i+1<n)   // if next element exists
            {
                long long sum2= nums[i]+nums[i+1];
                long long res2=(sum2 % 3==0) ? (sum2-dp[i+2]) : (sum2+dp[i+2]);
                dp[i]= max(dp[i],res2);
            }
        }
        return dp[0];
    }
};
