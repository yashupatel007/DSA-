class Solution {
public:
    int rob(vector<int>& nums) {
        int n=nums.size();
        if(n==1)    return nums[0];
        if(n==2)    return max(nums[0],nums[1]);

        //exclude the first
        int prev2=nums[1];
        int prev1=max(nums[1],nums[2]);

        for(int i=3;i<n;i++)
        {
            int maxi=max(nums[i]+prev2,prev1);
            prev2=prev1;
            prev1=maxi;
        }
        int exFirst=prev1;

        //exclude last
        int p2=nums[0];
        int p1=max(nums[0],nums[1]);

        for(int i=2;i<n-1;i++)
        {
            int maxi=max(nums[i]+p2,p1);
            p2=p1;
            p1=maxi;
        }
        int exLast=p1;
        return max(exFirst,exLast);
    }
};
