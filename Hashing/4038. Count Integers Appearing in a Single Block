class Solution {
public:
    int countSpecialIntegers(vector<int>& nums) {
        int n=nums.size();
        unordered_map<int,int>mp;

        //make blocks
        mp[nums[0]]=1;

        for(int i=1;i<n;i++)
        {
            if(nums[i]!=nums[i-1])
                mp[nums[i]]++;
        }

        //find which have only 1 block
        int groups=0;
        for(auto& x:mp)
        {
            if(x.second==1)
                groups++;
        }
        return groups;
    }
};
