TC- O( NlogN)
SC- O(N)
code-
class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n=nums.size();
        map<int,int>mp;
        for(int& num:nums)  mp[num]++;

        vector<int>ans;

        while(n>0)
        {
            for(auto& it:mp)
            {
                if(it.second!=0)
                {
                    ans.push_back(it.first);
                    it.second--;
                    n--;
                }
            }
        }
        return ans;
    }
};
