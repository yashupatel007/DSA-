TC - O(N^2)
SC - O(1)
code-

class Solution {
public:
    int countConsistent(vector<int>& nums) {
        int n=nums.size();
        int count=0;
        for(int i=0;i<n;i++)
        {
            int bitAnd=nums[i];
            int mini=nums[i];
            for(int j=i;j<n;j++)
            {
                bitAnd = bitAnd & nums[j];
                mini=min(mini,nums[j]);

                if(bitAnd==mini)
                    count++;
            }
        }
        return count;
    }
};
