class MyCalendarTwo {
public:
    using element=pair<int,int>;
    vector<element>booking;
    vector<element>overlap;
    // if 3rd overlap then its not valid
    MyCalendarTwo() {
        
    }
    
    bool book(int startTime, int endTime) {
        for(auto&[start,end]:overlap)
        {
            // overlap condition
            if(max(start,startTime) < min(end,endTime))
                return false;   // 3rd overlap
        }

        for(auto&[start,end]:booking)
        {
            if(max(start,startTime) < min(end,endTime))
                overlap.push_back({max(start,startTime),min(end,endTime)});
        }
        booking.push_back({startTime,endTime});
        return true;
    }
};

