class Solution {
public:
    int nthUglyNumber(int n) {
        // take the  3 pointers and increment only the min pointer value

        int p2=0;
        int p3=0;
        int p5=0;
        vector<int>ugly;
        ugly.push_back(1);

        for(int i=1;i<n;i++)
        {
            //  incremented min pointers only 
            int t2=ugly[p2] * 2;
            int t3=ugly[p3] * 3;
            int t5=ugly[p5] * 5;

            int mini=min({t2,t3,t5});

            // min values cab be same 
            if(mini==t2)
                p2++;
            if(mini==t3)
                p3++;
            if(mini==t5)
                p5++;

            ugly.push_back(mini);
        }
        return ugly[n-1];
    }
};
