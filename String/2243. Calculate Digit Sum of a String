class Solution {
public:
    string digitSum(string s, int k) {
        int n=s.size();

        string temp=s;
        string str=s;
        while(temp.size()>k)
        {
            temp=str;
            str="";

            int i=0;
        while(i<temp.size())
        {
            int sum=0;
            for(int j=0;j<k;j++)
            {
                if(i==temp.size())
                    break;

                sum=sum+(temp[i]-'0');
                i++;
            }
            str+=to_string(sum);
        }
        }
        return temp;
    }
};
