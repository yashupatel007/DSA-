class Solution {
public:
    vector<string> summaryRanges(vector<int>& nums) {
        int n=nums.size();
        vector<string>ans;
        int index=0;

        while(index<=n-1)
        {
            string temp="";
            int start=nums[index];
            while(index<n-1 && nums[index]+1==nums[index+1])
            {
                index++;
            }

            if(start!=nums[index])
            {
                int end=nums[index];
                temp+=to_string(start)+"->"+to_string(end);
            }
            else
            {
                temp+=to_string(start);
            }
                
            ans.push_back(temp);
            index++;
        }
       
        return ans;
    }
};
