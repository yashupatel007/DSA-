class Solution {
public:
   
    int findMinArrowShots(vector<vector<int>>& points) {
        sort(points.begin(),points.end(),[](const vector<int>& a,const vector<int>& b)
        {
            return a[1]<b[1];
        });
        int n=points.size();
        int count=1;
        int end=points[0][1];
        int i=1;
        while(i<n)
        {
            if(end<points[i][0])
            {
                count++;
                end=points[i][1];
            }
            i++;
        }
        

        return count;
    }
};
