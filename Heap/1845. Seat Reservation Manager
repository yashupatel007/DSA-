class SeatManager {
public:
    // minHeap for unsereved seats
    priority_queue<int,vector<int>,greater<int>>minHeap;
    // marker for reserving the seat(if minHeap is empty)
    int marker;

    SeatManager(int n) {
        marker=1;
    }
    
    int reserve() {
        // minHeap !empty
        if(!minHeap.empty())
        {
            int minSeat=minHeap.top();
            minHeap.pop();
            return minSeat;
        }
        // minHeap empty-> just return marker and incr. it
        int minSeat=marker;
        marker++;
        return minSeat;

    }
    
    void unreserve(int seatNumber) {
        minHeap.push(seatNumber);
    }
};

