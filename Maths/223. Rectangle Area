class Solution {
public:
    int computeArea(int ax1, int ay1, int ax2, int ay2, int bx1, int by1, int bx2, int by2) {
        // approach - ( Area of rec1 + Area of rec2 ) - (Overlapping Area)

        // Area of rec1
        int area1 = (ax2 - ax1) * (ay2 - ay1);
        // Area of rec2
        int area2 = (bx2 - bx1) * (by2 - by1);
        // Overalap cordinate
        int cx1=max(ax1,bx1);
        int cx2=min(ax2,bx2);
        int cy1=max(ay1,by1);
        int cy2=min(ay2,by2);

        int overlapWidth=max(0,cx2-cx1);
        int overlapHeight=max(0,cy2-cy1);
        // Overlap Area
        int OverlapArea= overlapHeight * overlapWidth;

        return (area1+area2)-OverlapArea;
    }
};
