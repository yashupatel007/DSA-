class MyCalendarThree {
public:
     map<int,int>mp;
    MyCalendarThree() {
        
    }
    
    int book(int startTime, int endTime) {
         mp[startTime]++;
        mp[endTime]--;

        int maxCount=INT_MIN;
        int currCount=0;
        for(auto& it:mp)
        {
            currCount+=it.second;
            maxCount=max(maxCount,currCount);
        }
        
        return maxCount;
    }
};

