SC- O(1)
code-

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* insertionSortList(ListNode* head) {
        ListNode dummy(0);   // allocate on stack
        dummy.next=head;    // in stack we use . instead of ->
        ListNode* curr=head;
         
        while(curr && curr->next)
        {
            if(curr->val > curr->next->val)
            {
                // isolate the node
                ListNode* temp= curr->next;
                curr->next= temp->next;

                //compare from head & find its right place
                ListNode* prev=&dummy;
                while(prev->next!=NULL)
                {
                    if(prev->next->val > temp->val) //place found
                    {
                        temp->next=prev->next;
                        prev->next=temp;
                        break;
                    }
                    prev=prev->next;
                }
            }
            else
            {
                curr=curr->next;
            }
        }
        return dummy.next;

    }
};
