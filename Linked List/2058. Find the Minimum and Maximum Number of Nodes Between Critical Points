/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    vector<int> nodesBetweenCriticalPoints(ListNode* head) {

        ListNode* prev=head;
        ListNode* curr=head->next;

        if(curr->next==NULL)
            return {-1,-1};

        ListNode* fut=curr->next;

        int p1=-1;
        int p2=-1;

        int index=2;
        int mini=INT_MAX;
        int pointFirst;
        while(fut!=NULL)
        {
            if(curr->val>prev->val && curr->val > fut->val)
            {
                if(p1==-1)
                {
                    p1=index;
                    pointFirst=p1;
                }
                else
                {
                    p2=index;
                    mini=min(mini,p2-p1);
                    p1=p2;
                }
            }
            else if(curr->val < prev->val && curr->val < fut->val)
            {
                if(p1==-1)
                {
                    p1=index;
                    pointFirst=p1;
                }
                else
                {
                    p2=index;
                    mini=min(mini,p2-p1);
                    p1=p2;
                }
            }
            index++;
            prev=curr;
            curr=fut;
            fut=fut->next;
        }
        int maxi=p2-pointFirst;

        if(p1==-1 || p2==-1)
            return {-1,-1};

        return {mini,maxi};
    }
};
