class Solution {
public:
    int minimumDeletions(vector<int>& nums) {
        int n=nums.size();
        int mini=0;
        int maxi=0;

        for(int i=0;i<n;i++)
        {
            if(nums[mini]>nums[i])
                mini=i;
            
            if(nums[maxi]<nums[i])
                maxi=i;
        }

        int i=min(mini,maxi);
        int j=max(mini,maxi);

        int front=j+1;
        int back=n-i;
        int bothSide=(i+1)+(n-j);

        return min({front,back,bothSide});
    }
};
